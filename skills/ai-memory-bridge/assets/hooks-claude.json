{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_SKILL_DIR}/scripts/capture.py\" --workspace \".\" --hook-event SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_SKILL_DIR}/scripts/capture.py\" --workspace \".\" --hook-event Stop"
          }
        ]
      }
    ]
  }
}
